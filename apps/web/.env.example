# Nunca commite o .env real — apenas este template.

# --- IA ---
# Provider do MVP. Usada só em rotas /api/* (no server), nunca no client
# (ver CLAUDE.md, regra 1).
OPENAI_API_KEY=

# O rate limit não precisa de configuração: o contador vive em memória, no
# processo da função (packages/server/src/memoryStore.ts). Nada a preencher.

# --- Banco ---
# Só a newsletter usa o Postgres (subscribers + newsletter_editions). Temas,
# scan, ideias e lente vivem no localStorage do navegador (apps/web/src/lib/
# storage.ts) e não precisam de banco — sem esta variável o app sobe e o
# produto principal funciona; só as rotas de newsletter recusam.
DATABASE_URL=

# --- Boletim ---
# Segredo do cron da Vercel. Sem ele, a rota de geração recusa (fail-closed).
CRON_SECRET=
# Base dos links absolutos. Ex.: https://stalo.dev
APP_URL=

# --- E-mail (em remoção junto com a newsletter) ---
RESEND_API_KEY=
NEWSLETTER_FROM=
NEWSLETTER_ADMIN_SECRET=
